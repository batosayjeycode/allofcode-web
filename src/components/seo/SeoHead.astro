---
/**
 * Page metadata: title, description, canonical, Open Graph, Twitter card and JSON-LD.
 * Every page passes its own title/description; nothing is inherited silently.
 */
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { site } from '../../data/site';
import { absoluteUrl } from '../../lib/seo';

export interface SeoProps {
  /** Page title without the brand suffix (the homepage passes its full title). */
  title: string;
  description: string;
  /** Path of this page on the canonical origin, e.g. "/tools/". */
  path: string;
  /** Use the title exactly as given (no " | AllOfCode" suffix). */
  rawTitle?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | undefined;
}

const {
  title,
  description,
  path,
  rawTitle = false,
  ogImage = site.ogImage,
  ogImageAlt = site.ogImageAlt,
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props as SeoProps;

const fullTitle = rawTitle ? title : `${title} | ${site.name}`;
const canonical = absoluteUrl(path);
const image = absoluteUrl(ogImage);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#090d12" />
<meta name="color-scheme" content="dark" />
<meta name="format-detection" content="telephone=no" />

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
