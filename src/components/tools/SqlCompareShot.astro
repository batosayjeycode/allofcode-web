---
/**
 * Real screenshot of SQL Compare (desktop, built-in example loaded),
 * captured from https://sql-compare.allofcode.com/. Served as responsive AVIF/WebP.
 */
import { Picture } from 'astro:assets';
import WindowFrame from '../ui/WindowFrame.astro';
import shot from '../../assets/sql-compare/sql-compare-desktop.png';

interface Props {
  /** true for above-the-fold placement (eager, high priority). */
  priority?: boolean;
  sizes?: string;
  caption?: string;
}
const {
  priority = false,
  sizes = '(min-width: 72rem) 640px, (min-width: 52rem) 55vw, 100vw',
  caption,
} = Astro.props;
---

<WindowFrame title="sql-compare.allofcode.com" meta="PostgreSQL · L2">
  <Picture
    src={shot}
    formats={['avif', 'webp']}
    widths={[480, 720, 960, 1440]}
    sizes={sizes}
    alt="SQL Compare comparing two versions of a PostgreSQL query side by side. The summary reports 4 semantic, 1 structural and 5 formatting differences, and the Differences panel lists an added u.email column and a JOIN changed from INNER to LEFT."
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
  {caption && (
    <figcaption slot="caption" class="shot-caption">
      {caption}
    </figcaption>
  )}
</WindowFrame>

<style>
  .shot-caption {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }
</style>
