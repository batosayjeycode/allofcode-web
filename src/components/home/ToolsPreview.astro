---
import SectionHeading from '../ui/SectionHeading.astro';
import ToolCard from '../tools/ToolCard.astro';
import { tools } from '../../data/tools';
---

<section class="section" aria-labelledby="tools-title">
  <div class="container tools-preview">
    <div class="tools-preview__head">
      <SectionHeading
        eyebrow="Tools directory"
        title="Developer tools you can use today"
        id="tools-title"
      >
        <p>
          Every tool listed here is live. Each one has its own page explaining what it does and
          where its limits are.
        </p>
      </SectionHeading>
      <a href="/tools/" class="link-arrow">
        Browse the tools directory
      </a>
    </div>

    <div class="tools-preview__grid">
      {tools.map((tool) => (
        <ToolCard tool={tool} />
      ))}

      <aside class="tools-preview__note" aria-label="About the collection">
        <p class="mono tools-preview__prompt" aria-hidden="true">
          ~/allofcode/tools
        </p>
        <p>
          The collection grows as new tools are finished. Nothing is listed until it works, so you
          won't find placeholder pages or release dates here.
        </p>
        <a href="/about/" class="link-arrow">
          How AllOfCode works
        </a>
      </aside>
    </div>
  </div>
</section>

<style>
  .tools-preview {
    display: grid;
    gap: var(--space-7);
  }

  .tools-preview__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .tools-preview__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }

  @media (min-width: 52rem) {
    .tools-preview__grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }

  .tools-preview__note {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
  }

  .tools-preview__prompt {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .tools-preview__prompt::before {
    content: '$ ';
    color: var(--color-accent);
  }
</style>
