---
/**
 * SQL Compare landing page: the search entry point for SQL comparison intent.
 * Every statement here was checked against the SQL Compare source
 * (github.com/batosayjeycode/sql-compare). Update it when the product changes.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import SqlCompareShot from '../../../components/tools/SqlCompareShot.astro';
import WindowFrame from '../../../components/ui/WindowFrame.astro';
import differencesShot from '../../../assets/sql-compare/sql-compare-differences.png';
import desktopShot from '../../../assets/sql-compare/sql-compare-desktop.png';
import { getImage } from 'astro:assets';
import { getTool } from '../../../data/tools';
import {
  absoluteUrl,
  breadcrumbSchema,
  graph,
  softwareApplicationSchema,
  type Crumb,
} from '../../../lib/seo';

const tool = getTool('sql-compare');
const path = tool.pagePath;
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Tools', path: '/tools/' },
  { name: tool.name, path },
];

const description =
  'Compare two SQL files or queries in your browser. SQL Compare separates formatting, structural and potentially semantic differences for PostgreSQL and MySQL.';

const featureList = [
  'Side-by-side and inline comparison of two SQL queries or files',
  'Classifies each difference as formatting, structural or potentially semantic',
  'PostgreSQL and MySQL / MariaDB parsers, plus a Generic mode',
  'Configurable normalization (L1, L2, aggressive L3)',
  'Original, Formatted and Normalized views',
  'Export the report as Markdown, HTML or JSON',
  'Runs entirely in the browser and works offline',
];

const screenshot = await getImage({ src: desktopShot, format: 'png', width: 1440 });

const seo = {
  title: 'SQL Compare Tool: Compare Two SQL Files Online',
  description,
  path,
  jsonLd: graph(
    softwareApplicationSchema(tool, {
      description,
      featureList,
      screenshot: absoluteUrl(screenshot.src),
    }),
    breadcrumbSchema(crumbs),
  ),
};

const toc = [
  ['what', 'What it does'],
  ['input', 'Supported input'],
  ['how-to', 'How to compare'],
  ['results', 'Reading results'],
  ['normalization', 'Normalization'],
  ['limitations', 'Limitations'],
  ['privacy', 'Privacy'],
  ['faq', 'Questions'],
] as const;

const classes = [
  {
    key: 'formatting',
    label: 'Formatting',
    body: 'Whitespace, comments or keyword case only. These are hidden by default so they don’t bury real changes.',
    example: 'select id  →  SELECT id',
  },
  {
    key: 'structural',
    label: 'Structural',
    body: 'The text is shaped differently, but the active normalization rules prove both sides equivalent. Each entry names the rule that proves it.',
    example: 'users  →  "users"',
  },
  {
    key: 'semantic',
    label: 'Potentially semantic',
    body: 'A change that may alter what the statement does: columns, tables, join type or conditions, predicates, literals, ORDER BY / LIMIT, DML or DDL targets.',
    example: 'INNER JOIN  →  LEFT JOIN',
  },
];

const dialects = [
  {
    name: 'PostgreSQL',
    parser: 'The real PostgreSQL parser (libpg-query), compiled to WebAssembly',
    support: 'Formatting, normalization (L1 to L3) and structural diff',
  },
  {
    name: 'MySQL / MariaDB',
    parser: 'node-sql-parser (MySQL build)',
    support: 'Formatting, normalization (L1 to L3) and structural diff',
  },
  {
    name: 'Generic',
    parser: 'No parser',
    support: 'Formatting and token diff; only L1 rules apply',
  },
];

const faqs = [
  {
    q: 'Is my SQL uploaded anywhere?',
    a: 'No. Parsing, normalization and comparison all run in your browser. SQL Compare has no backend that receives your SQL, no analytics, and its security policy only allows network requests to its own origin.',
  },
  {
    q: 'Does SQL Compare run my queries?',
    a: 'No. It never executes SQL and never connects to a database. It compares the text and structure of the two inputs.',
  },
  {
    q: 'Can I compare whole migration scripts with many statements?',
    a: 'Yes. Multi-statement scripts are split into statements, and statements are aligned between the two sides by similarity, so moved and edited statements are matched up.',
  },
  {
    q: 'What does “potentially semantic” mean?',
    a: 'It means SQL Compare could not prove the two versions equivalent under the active rules. Many of these really do change behaviour, such as a different join type. Some may be equivalent rewrites that are beyond what the tool proves, so treat them as “review this”.',
  },
  {
    q: 'My database isn’t PostgreSQL or MySQL. Can I still use it?',
    a: 'Yes, with the Generic mode. It formats both sides and shows a token-level diff, but without a parser it cannot detect structural equivalence.',
  },
  {
    q: 'Does it cost anything or need an account?',
    a: 'No. SQL Compare is free to use and has no accounts.',
  },
  {
    q: 'Does it work offline?',
    a: 'Yes. After the first visit it is cached as an installable web app (PWA) and keeps working without a connection.',
  },
];
---

<BaseLayout {...seo}>
  <section class="sc-hero" aria-labelledby="page-title">
    <div class="sc-hero__bg" aria-hidden="true"></div>
    <div class="container sc-hero__grid">
      <div class="sc-hero__copy">
        <Breadcrumbs crumbs={crumbs} />
        <p class="eyebrow">Free SQL diff tool</p>
        <h1 id="page-title">Compare two SQL files and see what actually changed</h1>
        <p class="lead">
          SQL Compare puts two SQL queries or scripts side by side and sorts every difference into{' '}
          <strong>formatting</strong>, <strong>structural</strong> or{' '}
          <strong>potentially semantic</strong>, with a plain-language explanation for each one. It
          runs entirely in your browser.
        </p>
        <div class="btn-row">
          <a href={tool.appUrl} class="btn btn--primary">
            Open SQL Compare
          </a>
          <a href="#how-to" class="btn">
            How to compare two SQL files
          </a>
        </div>
      </div>

      <dl class="facts">
        <div>
          <dt>Dialects</dt>
          <dd>PostgreSQL, MySQL / MariaDB, Generic</dd>
        </div>
        <div>
          <dt>Files</dt>
          <dd>
            <code>.sql</code> <code>.txt</code> <code>.ddl</code> or paste
          </dd>
        </div>
        <div>
          <dt>Runs</dt>
          <dd>In your browser, also offline</dd>
        </div>
        <div>
          <dt>Cost</dt>
          <dd>Free, no account</dd>
        </div>
      </dl>
    </div>

    <div class="container sc-hero__shot">
      <SqlCompareShot
        priority
        sizes="(min-width: 76rem) 1152px, 100vw"
        caption="SQL Compare with its built-in example loaded: 4 potentially semantic, 1 structural and 5 formatting differences."
      />
    </div>
  </section>

  <nav class="toc" aria-label="On this page">
    <div class="container">
      <ul class="toc__list">
        {toc.map(([id, label]) => (
          <li>
            <a href={`#${id}`}>{label}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <article class="sc-body">
    <!-- What it does -->
    <section id="what" class="section" aria-labelledby="what-title">
      <div class="container">
        <div class="block-head">
          <p class="eyebrow">What it does</p>
          <h2 id="what-title">Separate cosmetic changes from meaningful ones</h2>
          <p class="lead">
            A plain text diff flags every reindent and every <code>select</code> that became{' '}
            <code>SELECT</code>. SQL Compare parses both sides, normalizes what is provably safe to
            normalize, and classifies each remaining difference into one of three groups.
          </p>
        </div>

        <ul class="classes">
          {classes.map((c) => (
            <li class:list={['class-card', `class-card--${c.key}`]}>
              <h3>{c.label}</h3>
              <p>{c.body}</p>
              <p class="class-card__example">
                <span class="visually-hidden">Example: </span>
                <code>{c.example}</code>
              </p>
            </li>
          ))}
        </ul>

        <div class="two-col">
          <div class="prose">
            <h3>Who it is for</h3>
            <ul>
              <li>Developers reviewing a changed query in a pull request.</li>
              <li>Database engineers checking a migration script before running it.</li>
              <li>
                Anyone handed a “cleaned up” query who needs to confirm the logic didn't change.
              </li>
              <li>QA engineers and analysts comparing the SQL behind two versions of a report.</li>
            </ul>
          </div>
          <div class="prose">
            <h3>SQL diff, not database diff</h3>
            <p>
              SQL Compare compares <strong>two pieces of SQL text</strong>. It does not connect to a
              database, so it won't compare live schemas or table data. To see how two schemas
              differ, export each one as DDL and compare those files.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Supported input -->
    <section id="input" class="section" aria-labelledby="input-title">
      <div class="container">
        <div class="block-head">
          <p class="eyebrow">Supported input</p>
          <h2 id="input-title">Dialects, files and scripts</h2>
          <p class="lead">
            Choose the dialect that matches your SQL. Parsers run in a Web Worker, so typing stays
            responsive while the comparison updates.
          </p>
        </div>

        <div class="table-wrap" role="region" aria-label="Supported SQL dialects" tabindex="0">
          <table class="data-table">
            <caption class="visually-hidden">SQL dialects supported by SQL Compare</caption>
            <thead>
              <tr>
                <th scope="col">Dialect</th>
                <th scope="col">Parser</th>
                <th scope="col">What you get</th>
              </tr>
            </thead>
            <tbody>
              {dialects.map((d) => (
                <tr>
                  <th scope="row">{d.name}</th>
                  <td>{d.parser}</td>
                  <td>{d.support}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="prose input-notes">
          <ul>
            <li>
              <strong>Paste, drop or upload.</strong> Each side accepts pasted text, a dropped file,
              or the Upload button. Accepted file types are <code>.sql</code>, <code>.txt</code> and
              <code>.ddl</code>.
            </li>
            <li>
              <strong>Large files.</strong> Files over 5 MB still open, with a warning that the
              comparison may be slow.
            </li>
            <li>
              <strong>Encodings.</strong> UTF-8 and UTF-16 (with a byte-order mark) are detected.
              Files that aren't valid UTF-8 are decoded as Windows-1252, with a notice.
            </li>
            <li>
              <strong>Multi-statement scripts.</strong> Scripts are split into statements while
              respecting strings, comments, PostgreSQL dollar quoting and MySQL{' '}
              <code>DELIMITER</code> changes, then aligned between the two sides.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- How to -->
    <section id="how-to" class="section" aria-labelledby="howto-title">
      <div class="container two-col two-col--wide">
        <div>
          <div class="block-head">
            <p class="eyebrow">Step by step</p>
            <h2 id="howto-title">How to compare two SQL files</h2>
          </div>
          <ol class="steps">
            <li>
              <h3>Open the tool</h3>
              <p>
                Go to <a href={tool.appUrl}>sql-compare.allofcode.com</a>. To see how it works
                first, click <strong>Load example</strong>.
              </p>
            </li>
            <li>
              <h3>Pick the dialect</h3>
              <p>
                Choose PostgreSQL, MySQL / MariaDB or Generic from the <strong>Dialect</strong>{' '}
                menu.
              </p>
            </li>
            <li>
              <h3>Add the original SQL</h3>
              <p>
                Paste it into the <strong>Original</strong> pane on the left, drop a file on it, or
                use
                <strong>Upload</strong>.
              </p>
            </li>
            <li>
              <h3>Add the modified SQL</h3>
              <p>
                Do the same in the <strong>Modified</strong> pane. The comparison runs as you type;
                there is no compare button.
              </p>
            </li>
            <li>
              <h3>Review the differences</h3>
              <p>
                Work through the <strong>Differences</strong> panel. Use the Semantic, Structural
                and Formatting filters to focus, and <kbd>n</kbd> / <kbd>p</kbd> (or <kbd>F7</kbd> /
                <kbd>Shift</kbd>+<kbd>F7</kbd>) to jump between differences.
              </p>
            </li>
            <li>
              <h3>Export if you need a record</h3>
              <p>
                <strong>Export</strong> saves the report as Markdown, HTML or JSON, which is handy
                for a code review comment or a change ticket.
              </p>
            </li>
          </ol>
        </div>

        <aside class="howto-aside" aria-label="Example input">
          <WindowFrame title="Original vs Modified" meta="PostgreSQL">
            <pre
              class="sql-sample"
              tabindex="0"
              aria-label="Example: original and modified query"
            ><code><span class="cm">-- Original</span>
<span class="kw">SELECT</span> u.id, u.name, <span class="kw">SUM</span>(o.total) <span class="kw">AS</span> total
<span class="kw">FROM</span> users u
<span class="kw">INNER JOIN</span> orders o <span class="kw">ON</span> o.user_id = u.id
<span class="kw">WHERE</span> u.active = 1

<span class="cm">-- Modified</span>
<span class="kw">select</span> u.id, u.name, <mark>u.email</mark>, <span class="kw">sum</span>(o.total) <span class="kw">as</span> total
<span class="kw">from</span> "users" u
<mark><span class="kw">left join</span></mark> orders o <span class="kw">on</span> o.user_id = u.id
<span class="kw">where</span> u.active = <mark>true</mark></code></pre>
            <p slot="caption" class="sample-caption">
              An excerpt of the built-in example. Lowercased keywords are formatting,
              <code>"users"</code> is structural, and the highlighted changes are potentially
              semantic.
            </p>
          </WindowFrame>
        </aside>
      </div>
    </section>

    <!-- Reading results -->
    <section id="results" class="section" aria-labelledby="results-title">
      <div class="container two-col two-col--media">
        <figure class="results-shot">
          <Picture
            src={differencesShot}
            formats={['avif', 'webp']}
            widths={[380, 760]}
            sizes="(min-width: 52rem) 380px, 90vw"
            alt="The Differences panel for the example. Under Statement 1, SELECT: added column u.email, marked major. FROM: users changed to quoted users, marked info and resolved by the rule Remove redundant identifier quotes; JOIN orders changed from INNER to LEFT, marked major. WHERE: predicate changed from u.active = 1 to u.active = true, major. GROUP BY: added item u.email, major."
            loading="lazy"
            decoding="async"
          />
          <figcaption>The Differences panel, docked to the right.</figcaption>
        </figure>

        <div class="prose">
          <p class="eyebrow">Reading results</p>
          <h2 id="results-title">What the result tells you</h2>
          <p>
            Differences are grouped by <strong>statement</strong>, then by <strong>clause</strong>
            (SELECT, FROM, WHERE, GROUP BY and so on). Each entry says what changed in words, such
            as “JOIN <code>orders</code> changed from INNER to LEFT”. Click an entry to jump to it
            in the editor.
          </p>
          <h3>Severity</h3>
          <ul>
            <li>
              <strong>major</strong>: can change which rows are read or written, or the schema.
            </li>
            <li>
              <strong>minor</strong>: changes the shape or presentation of the result, or metadata.
            </li>
            <li>
              <strong>info</strong>: formatting and structural differences.
            </li>
          </ul>
          <h3>Overall verdict</h3>
          <p>
            The status bar sums up the comparison as <em>Identical</em>, <em>Formatting only</em>,
            <em>Equivalent (structural)</em>, <em>Potentially semantic</em>, or{' '}
            <em>Unknown (unparsed SQL)</em>.
          </p>
          <h3>Views and layout</h3>
          <p>
            Switch between the <strong>Original</strong> text (editable), a{' '}
            <strong>Formatted</strong>
            version, and a <strong>Normalized</strong> version that shows what is left after the
            active rules. Diffs can be shown side by side or inline. On small screens the panes
            become Left, Right, Diff and Summary tabs.
          </p>
        </div>
      </div>
    </section>

    <!-- Normalization -->
    <section id="normalization" class="section" aria-labelledby="norm-title">
      <div class="container">
        <div class="block-head">
          <p class="eyebrow">Normalization</p>
          <h2 id="norm-title">How SQL Compare decides two queries are equivalent</h2>
          <p class="lead">
            Normalization rewrites each statement into a canonical form before comparing. A rule is
            kept only if the re-parsed statement still matches the original's syntax tree, so it
            can't silently change the meaning.
          </p>
        </div>

        <ol class="levels">
          <li class="level">
            <span class="level__tag mono">L1</span>
            <h3>Always on</h3>
            <p>Whitespace, comments and statement terminators. This is what “formatting” means.</p>
          </li>
          <li class="level">
            <span class="level__tag mono">L2</span>
            <h3>Default</h3>
            <p>
              Dialect-aware rules such as keyword case, redundant identifier quotes, optional{' '}
              <code>AS</code>, <code>!=</code> vs <code>&lt;&gt;</code>, and join keyword synonyms.
            </p>
          </li>
          <li class="level">
            <span class="level__tag mono">L3</span>
            <h3>Aggressive (opt-in)</h3>
            <p>
              Proves safe reorderings: AND/OR operands, <code>=</code>, IN lists, GROUP BY,
              PARTITION BY and comma-joined FROM lists, but only when the operands have no function
              calls or subqueries.
            </p>
          </li>
        </ol>

        <div class="two-col">
          <div class="prose">
            <p>
              L2 and L3 rules (and terminator handling) can each be switched off under
              <strong>Normalize</strong>. At L2, if aggressive mode would resolve a difference, the
              entry shows a hint: “may be structural under aggressive normalization”.
            </p>
          </div>
          <div class="prose">
            <h3>Never treated as equivalent</h3>
            <p>
              SELECT column order, ORDER BY items, UNION branches, outer-join order, numeric literal
              form (<code>1.0</code> vs <code>1.00</code>), and AND/OR chains that contain function
              calls or subqueries.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Limitations -->
    <section id="limitations" class="section" aria-labelledby="limits-title">
      <div class="container two-col">
        <div class="block-head">
          <p class="eyebrow">Known limitations</p>
          <h2 id="limits-title">What SQL Compare doesn't do</h2>
          <p class="lead">Knowing the limits tells you when to reach for something else.</p>
        </div>
        <ul class="limits">
          <li>It doesn't execute SQL or connect to a database.</li>
          <li>
            It isn't schema-aware: it doesn't expand <code>SELECT *</code>, check types or look up
            tables.
          </li>
          <li>It doesn't compare query plans or performance.</li>
          <li>
            It doesn't prove every equivalence. Rewrites like turning a subquery into a join are
            reported as potentially semantic.
          </li>
          <li>
            Statements the parser can't read, such as procedural blocks, client commands or vendor
            extensions, are compared as text and treated as potentially semantic.
          </li>
          <li>
            Only PostgreSQL and MySQL / MariaDB are parsed. Other dialects (for example SQLite, SQL
            Server, BigQuery or Snowflake) can use Generic mode.
          </li>
          <li>
            MySQL table names are compared case-sensitively unless you enable the
            <code>lower_case_table_names</code> option.
          </li>
          <li>There are no shareable links; reports are exported as files.</li>
        </ul>
      </div>
    </section>

    <!-- Privacy -->
    <section id="privacy" class="section" aria-labelledby="privacy-title">
      <div class="container two-col">
        <div class="block-head">
          <p class="eyebrow">Privacy and data handling</p>
          <h2 id="privacy-title">Your SQL never leaves the browser</h2>
        </div>
        <div class="prose">
          <ul>
            <li>
              <strong>Local processing.</strong> Parsing, formatting, normalization and diffing run
              in Web Workers on your device.
            </li>
            <li>
              <strong>No uploads, no analytics.</strong> The app's Content Security Policy only
              allows connections to its own origin, so SQL can't be sent to third parties.
            </li>
            <li>
              <strong>Works offline.</strong> After the first visit, a service worker caches the app
              so it runs without a network connection.
            </li>
            <li>
              <strong>Drafts in your browser.</strong> By default both inputs are saved to this
              browser's local storage so they survive a reload. Untick <strong>Save drafts</strong>{' '}
              to turn this off, for example on a shared computer.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="section" aria-labelledby="faq-title">
      <div class="container faq">
        <div class="block-head">
          <p class="eyebrow">Questions</p>
          <h2 id="faq-title">Common questions about SQL Compare</h2>
        </div>
        <div class="faq__list">
          {faqs.map((f) => (
            <details class="faq__item">
              <summary>
                <h3>{f.q}</h3>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section" aria-labelledby="cta-title">
      <div class="container">
        <div class="cta">
          <div>
            <h2 id="cta-title">Ready to compare your SQL?</h2>
            <p class="muted">
              Paste two queries or drop two files. Nothing to install and no account to create.
            </p>
          </div>
          <div class="btn-row">
            <a href={tool.appUrl} class="btn btn--primary">
              Open SQL Compare
            </a>
            {tool.sourceUrl && (
              <a href={`${tool.sourceUrl}/issues`} class="btn">
                Report an issue on GitHub
              </a>
            )}
          </div>
        </div>
        <p class="more">
          <a href="/tools/" class="link-arrow">
            Browse more developer tools
          </a>
        </p>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  /* Hero */
  .sc-hero {
    position: relative;
    padding-top: var(--space-7);
    isolation: isolate;
  }

  .sc-hero__bg {
    position: absolute;
    inset: 0 0 30%;
    z-index: -1;
    background:
      radial-gradient(44rem 22rem at 85% 0%, rgb(76 201 240 / 0.08), transparent 70%),
      linear-gradient(var(--color-grid) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: linear-gradient(to bottom, black 50%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, black 50%, transparent);
  }

  .sc-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: end;
  }

  @media (min-width: 60rem) {
    .sc-hero__grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .sc-hero__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .sc-hero h1 {
    max-width: 20ch;
    font-size: var(--text-2xl);
  }

  .sc-hero .lead strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-border);
  }

  .facts > div {
    padding: var(--space-4);
    background: var(--color-surface);
  }

  .facts dt {
    margin-bottom: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .facts dd {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .facts code {
    font-size: 0.85em;
  }

  .sc-hero__shot {
